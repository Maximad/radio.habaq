# Public AzuraCast installation URL, without a trailing slash.
VITE_AZURACAST_URL=https://cast.example.com

# AzuraCast station shortcode, for example: radio_habaq
VITE_AZURACAST_STATION=radio_habaq

# Optional overrides. Leave blank to derive Now Playing from the values above
# and to use the station listen URL returned by AzuraCast.
VITE_AZURACAST_NOW_PLAYING_URL=
VITE_STREAM_URL=
