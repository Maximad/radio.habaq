# Radio Habaq currently uses these public AzuraCast endpoints by default.
# Override them only if the broadcast backend moves to another host/station.
VITE_AZURACAST_URL=https://radio.habaq.media
VITE_AZURACAST_STATION=habaq

# Optional explicit overrides.
VITE_AZURACAST_NOW_PLAYING_URL=https://radio.habaq.media/api/nowplaying/habaq
VITE_STREAM_URL=https://radio.habaq.media/listen/habaq/radio.mp3
